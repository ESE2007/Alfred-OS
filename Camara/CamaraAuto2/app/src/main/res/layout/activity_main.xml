<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fitsSystemWindows="true">

    <!-- El tamaño de la vista previa y de la cuadrícula se ajusta desde el código (relación 3:4) -->
    <TextureView
        android:id="@+id/textureView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.camaraauto2.GridOverlay
        android:id="@+id/gridOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <View
        android:id="@+id/focusRing"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:alpha="0"
        android:background="@drawable/focus_ring" />

    <!-- Barra superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:id="@+id/btnMode"
            style="@style/Pill"
            android:text="MODO: AUTO" />

        <TextView
            android:id="@+id/btnGrid"
            style="@style/Pill"
            android:text="▦" />
    </LinearLayout>

    <TextView
        android:id="@+id/sceneLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="72dp"
        android:background="@drawable/pill_bg"
        android:gravity="center"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:text="Iniciando cámara…"
        android:textColor="#FFFFFF"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/zoomLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="150dp"
        android:background="@drawable/pill_bg"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:text="1.0x"
        android:textColor="#FFD54F"
        android:textSize="13sp" />

    <!-- Aviso mientras la cámara procesa -->
    <TextView
        android:id="@+id/processing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/pill_bg"
        android:gravity="center"
        android:padding="20dp"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:visibility="gone" />

    <View
        android:id="@+id/shutter"
        android:layout_width="78dp"
        android:layout_height="78dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="48dp"
        android:background="@drawable/shutter"
        android:clickable="true"
        android:focusable="true" />

</FrameLayout>
